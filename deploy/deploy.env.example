# Copy to deploy/deploy.env and fill in before running
# deploy/cloudflared/install-cloudflared.sh. That script also falls back to
# prompting interactively for anything left unset here, and to the defaults
# below for anything not mentioned at all.
#
# deploy/deploy.env is gitignored -- nothing in this file is a secret, but
# real credentials never go in either file: the tunnel's credentials JSON is
# generated by `cloudflared tunnel create` itself (see install-cloudflared.sh)
# and installed straight to /etc/cloudflared, never committed or templated
# here.

# The hostname the app will be reachable at once the tunnel is live. Must be
# a domain (or subdomain) already onboarded to your Cloudflare account.
ARTBOARD_PUBLIC_HOSTNAME=artboard.example.com

# Name of the Cloudflare Tunnel to create (or reuse, if it already exists).
# Defaults to "artboard" if unset.
ARTBOARD_TUNNEL_NAME=artboard

# Local port the tunnel forwards to. Must match FRONTEND_PORT in
# backend/deploy/artboard-ctl (4173 by default) -- the frontend already
# proxies /api to the backend itself, so the tunnel only ever needs this one
# port. Defaults to 4173 if unset.
ARTBOARD_TUNNEL_LOCAL_PORT=4173
