#!/usr/bin/env bash
# artboard-ctl -- install / update / remove Art Board (artboard/Pineart)
# on a Debian 12 LXC, no Docker, systemd-managed, release/symlink deploys.
#
# This script lives IN the app repo (backend/deploy/artboard-ctl), not in a
# separate infra repo, and is self-aware of where it came from -- it does
# not hardcode REPO_URL. See "Repo URL detection" below.
#
# Bootstrap (fresh LXC, first install):
#   git clone https://github.com/istorie-petru/pineart.git /tmp/bootstrap
#   sudo /tmp/bootstrap/backend/deploy/artboard-ctl install
#   rm -rf /tmp/bootstrap   # install already copied itself to /usr/local/bin
#
# Day to day, once installed:
#   sudo artboard-ctl update    # deploy latest main, atomic swap, auto-rollback
#   sudo artboard-ctl remove    # tear down (destructive, confirms)
#
# Layout:
#   /srv/artboard/releases/release_<timestamp>_<hash>/   one per deploy, built
#     under it: backend/.venv (pip) and frontend/dist (vite build)
#   /srv/artboard/current -> releases/<latest>            atomically swapped
#   /srv/artboard/previous -> releases/<prior>             swap target for rollback
#   /srv/artboard/shared/.env                              persistent config (EnvironmentFile)
#   /srv/artboard/shared/repo_url                          persisted origin URL (see below)
#   /srv/artboard/shared/data/                             db.sqlite3 + images (survives swaps)
#   /srv/artboard/shared/backups/                           pre-migration db.sqlite3 snapshots
#
# `update` deploys whatever is on the tip of GIT_BRANCH (main), not a specific
# tag -- unlike a hand-run `git checkout vX.Y.Z`, this is deliberate: the
# safety net for a bad migration is the pre-migration backup this script
# always takes (see cmd_update), not gating deploys behind a tag.
#
# The frontend is *not* systemd-managed: Caddy (backend/deploy/Caddyfile.example)
# serves ${CURRENT_LINK}/frontend/dist directly and re-reads that path on every
# request, so the atomic symlink swap below updates the frontend too, with no
# separate frontend service to restart.
#
# Repo URL detection:
#   `install` needs a repo to clone. It never hardcodes one; instead:
#     1. $ARTBOARD_REPO_URL env var, if set (explicit override -- also how
#        you'd point this at a fork, or run it from a separate infra repo
#        instead of the in-repo layout this file assumes).
#     2. Otherwise, `git remote get-url origin` from wherever THIS script
#        currently sits on disk -- which is why the bootstrap flow above
#        clones the app repo to /tmp/bootstrap first and runs the script
#        from inside that clone, rather than curl-ing just the raw file.
#   Whichever URL wins gets written to shared/repo_url so `update` and
#   `remove` (run later, against the copy at /usr/local/bin, which has no
#   git context of its own) know where to clone from without re-detecting.
set -euo pipefail

# --- constants (match backend/app/config.py, artboard.service, Caddyfile.example) ---
APP_NAME="artboard"
APP_USER="artboard"
GIT_BRANCH="main"
TARGET_PORT=8000
HEALTH_PATH="/api/health"
KEEP_RELEASES=5
KEEP_BACKUPS=5
INSTALLED_CTL="/usr/local/bin/${APP_NAME}-ctl"

BASE_DIR="/srv/${APP_NAME}"
RELEASES_DIR="${BASE_DIR}/releases"
SHARED_DIR="${BASE_DIR}/shared"
DATA_DIR="${SHARED_DIR}/data"
BACKUP_DIR="${SHARED_DIR}/backups"
DB_FILE="${DATA_DIR}/db.sqlite3"
CURRENT_LINK="${BASE_DIR}/current"
PREVIOUS_LINK="${BASE_DIR}/previous"
ENV_FILE="${SHARED_DIR}/.env"
REPO_URL_FILE="${SHARED_DIR}/repo_url"
UNIT_FILE="/etc/systemd/system/${APP_NAME}.service"
PURGE_SERVICE_FILE="/etc/systemd/system/${APP_NAME}-purge.service"
PURGE_TIMER_FILE="/etc/systemd/system/${APP_NAME}-purge.timer"

# --- colored logging ---------------------------------------------------------
RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; NC='\033[0m'
log()  { echo -e "${GREEN}==>${NC} $*"; }
warn() { echo -e "${YELLOW}==>${NC} $*"; }
err()  { echo -e "${RED}==>${NC} $*" >&2; }

require_root() {
  if [ "$(id -u)" -ne 0 ]; then
    err "artboard-ctl must run as root (sudo)."
    exit 1
  fi
}

# --- repo URL: detect once (install), persist, load thereafter -------------
detect_repo_url_from_self() {
  # Works only when this script is still sitting inside a git working tree
  # (the bootstrap clone at /tmp/bootstrap) -- not once it's a bare copy
  # at /usr/local/bin, which is the whole reason install() persists it.
  local script_dir
  script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  if git -C "$script_dir" rev-parse --git-dir >/dev/null 2>&1; then
    git -C "$script_dir" remote get-url origin 2>/dev/null || true
  fi
}

resolve_repo_url_for_install() {
  if [ -n "${ARTBOARD_REPO_URL:-}" ]; then
    echo "$ARTBOARD_REPO_URL"
    return
  fi
  local detected
  detected="$(detect_repo_url_from_self)"
  if [ -n "$detected" ]; then
    echo "$detected"
    return
  fi
  err "Could not determine the app repo's URL."
  err "Run this from inside a git clone of the app repo, e.g.:"
  err "    git clone <repo-url> /tmp/bootstrap && sudo /tmp/bootstrap/backend/deploy/artboard-ctl install"
  err "or set it explicitly:"
  err "    sudo ARTBOARD_REPO_URL=<repo-url> -E artboard-ctl install"
  exit 1
}

load_repo_url() {
  if [ -n "${ARTBOARD_REPO_URL:-}" ]; then
    echo "$ARTBOARD_REPO_URL"
    return
  fi
  if [ -f "$REPO_URL_FILE" ]; then
    cat "$REPO_URL_FILE"
    return
  fi
  err "${REPO_URL_FILE} not found -- has 'install' been run yet?"
  exit 1
}

# --- shared helpers -----------------------------------------------------------
ensure_user() {
  if ! id -u "$APP_USER" >/dev/null 2>&1; then
    log "Creating system user '$APP_USER'..."
    useradd --system --home-dir "$SHARED_DIR" --shell /usr/sbin/nologin "$APP_USER"
  fi
}

ensure_dirs() {
  log "Creating directory layout under ${BASE_DIR}..."
  install -d -o "$APP_USER" -g "$APP_USER" "$RELEASES_DIR" "$SHARED_DIR" \
    "$DATA_DIR" "$DATA_DIR/images"
  # Root-owned: backups are written by this script running as root (via
  # cmd_update's sqlite3 .backup step), not by the app itself.
  install -d -o root -g root "$BACKUP_DIR"
}

# apt packages needed to build+run a release: git/rsync/curl for the deploy
# itself, sqlite3 for online pre-migration backups, python3-venv for the
# backend venv, and the Pillow/argon2-cffi build toolchain from
# backend/Dockerfile's build stage (cheap no-ops if already installed).
ensure_system_packages() {
  local pkgs=(git rsync curl openssl sqlite3 python3 python3-venv python3-pip
              build-essential libffi-dev libjpeg-dev zlib1g-dev libwebp-dev)
  local missing=()
  local pkg
  for pkg in "${pkgs[@]}"; do
    dpkg -s "$pkg" >/dev/null 2>&1 || missing+=("$pkg")
  done
  if [ "${#missing[@]}" -gt 0 ]; then
    log "Installing apt packages: ${missing[*]}..."
    apt-get update -qq
    apt-get install -y --no-install-recommends "${missing[@]}"
  fi
}

ensure_node() {
  if command -v npm >/dev/null 2>&1; then
    return
  fi
  log "Installing Node.js 20.x (NodeSource) for the frontend build..."
  curl -fsSL https://deb.nodesource.com/setup_20.x | bash -
  apt-get install -y nodejs
}

self_install() {
  # Copies whatever script is currently running to /usr/local/bin, so
  # `update`/`remove` work without the bootstrap clone sticking around.
  # `install` (a temp file + rename) is safe to run even when overwriting
  # the copy of this same script currently executing -- the running
  # process keeps reading from the old inode until it exits.
  local self_path
  self_path="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"
  if [ "$(readlink -f "$self_path")" != "$(readlink -f "$INSTALLED_CTL" 2>/dev/null || echo "")" ]; then
    log "Installing this script to ${INSTALLED_CTL}..."
    install -m 0755 "$self_path" "$INSTALLED_CTL"
  fi
}

write_env_template() {
  if [ -f "$ENV_FILE" ]; then
    warn ".env already exists at ${ENV_FILE}, leaving it untouched."
    return
  fi
  log "Generating ${ENV_FILE}..."
  cat > "$ENV_FILE" <<EOF
# artboard configuration -- generated by artboard-ctl install on $(date -Is)
# This file is EnvironmentFile for the systemd units. It lives in shared/,
# outside any release directory, so it survives every 'update' swap.
# Full list of options: backend/.env.example in the app repo.

# Pinned explicitly (rather than left to the platform-default XDG/var-lib
# lookup in app/config.py) so it always resolves to the shared data dir,
# regardless of which release directory is currently WorkingDirectory.
ARTBOARD_DATA_DIR=${DATA_DIR}

# Same-origin behind Caddy (Caddyfile.example), so no CORS origins needed.
ARTBOARD_CORS_ORIGINS=

# Caddy terminates TLS, so the session cookie is marked Secure. Set this to
# false only if you are deliberately serving over plain HTTP.
ARTBOARD_SECURE_COOKIES=true

# Max accepted upload size per file, in bytes (default 32 MiB).
ARTBOARD_MAX_UPLOAD_BYTES=33554432

# Internal SearXNG base URL for the Feed/discovery proxy. Leave unset to run
# without Discovery; the value under Settings -> Discovery takes precedence
# over this one once set there.
# ARTBOARD_SEARXNG_URL=http://127.0.0.1:8888/
EOF
  chown root:"$APP_USER" "$ENV_FILE"
  chmod 0640 "$ENV_FILE"
}

write_unit() {
  log "Writing systemd unit to ${UNIT_FILE}..."
  cat > "$UNIT_FILE" <<EOF
# artboard -- managed by artboard-ctl. Re-generated on every 'install';
# use a drop-in at ${UNIT_FILE}.d/ for local overrides instead of editing
# this file directly, or they will be silently overwritten.
[Unit]
Description=Art Board App
After=network.target

[Service]
Type=simple
User=${APP_USER}
Group=${APP_USER}
WorkingDirectory=${CURRENT_LINK}/backend
EnvironmentFile=${ENV_FILE}
# Bound to loopback: Caddy (or nginx) is the only thing that should reach
# this directly -- see Caddyfile.example.
ExecStart=${CURRENT_LINK}/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port ${TARGET_PORT}
Restart=on-failure
RestartSec=3

# Hardening. The app writes user-supplied files to disk, so limiting what
# the process can touch is the difference between a bad upload being a bad
# upload and it being a foothold.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=${DATA_DIR}
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=false

[Install]
WantedBy=multi-user.target
EOF

  log "Writing purge timer to ${PURGE_SERVICE_FILE} / ${PURGE_TIMER_FILE}..."
  cat > "$PURGE_SERVICE_FILE" <<EOF
[Unit]
Description=Art Board trash purge
After=network.target

[Service]
Type=oneshot
User=${APP_USER}
Group=${APP_USER}
WorkingDirectory=${CURRENT_LINK}/backend
ExecStart=${CURRENT_LINK}/backend/.venv/bin/python -m app.cli purge
EnvironmentFile=${ENV_FILE}
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=${DATA_DIR}
EOF
  cat > "$PURGE_TIMER_FILE" <<EOF
[Unit]
Description=Run the Art Board trash purge daily

[Timer]
OnCalendar=daily
# Runs the purge on next boot if the machine was off when it was due -- an
# LXC that is shut down overnight would otherwise never purge.
Persistent=true
RandomizedDelaySec=15m

[Install]
WantedBy=timers.target
EOF
  systemctl daemon-reload
}

health_check() {
  local url="http://127.0.0.1:${TARGET_PORT}${HEALTH_PATH}"
  local attempts=30
  for i in $(seq 1 "$attempts"); do
    if curl -fsS -o /dev/null "$url"; then
      return 0
    fi
    sleep 1
  done
  return 1
}

atomic_symlink() {
  # $1 = target, $2 = link name. Uses a temp symlink + rename(2) via `mv -T`
  # so readers (systemd on restart, Caddy on every request) never observe a
  # missing/half-written link.
  local target="$1" link="$2" tmp
  tmp="$(mktemp -u "${link}.XXXXXX")"
  ln -s "$target" "$tmp"
  mv -T "$tmp" "$link"
}

prune_dir_keeping_current_previous() {
  # $1 = directory, $2 = glob prefix, $3 = keep count. Shared by
  # prune_releases (never delete current/previous's targets) below.
  local dir="$1" prefix="$2" keep="$3"
  # shellcheck disable=SC2012
  ls -1dt "${dir}/${prefix}"* 2>/dev/null | tail -n +$((keep + 1)) | \
    while read -r old; do
      if [ "$(readlink -f "$CURRENT_LINK" 2>/dev/null)" = "$(readlink -f "$old")" ]; then continue; fi
      if [ "$(readlink -f "$PREVIOUS_LINK" 2>/dev/null)" = "$(readlink -f "$old")" ]; then continue; fi
      rm -rf "$old"
    done
}

prune_releases() {
  log "Pruning old releases (keeping last ${KEEP_RELEASES})..."
  prune_dir_keeping_current_previous "$RELEASES_DIR" "release_" "$KEEP_RELEASES"
}

prune_backups() {
  # shellcheck disable=SC2012
  ls -1t "${BACKUP_DIR}"/db-pre-migration-*.sqlite3 2>/dev/null | tail -n +$((KEEP_BACKUPS + 1)) | \
    xargs -r rm -f
}

backup_db_if_present() {
  # Online-safe snapshot via sqlite3's own .backup command, which handles a
  # live WAL-mode database correctly -- unlike `cp`, it cannot capture a torn
  # mix of the main file and the WAL, so the app does not need to be stopped
  # first. Skipped on a fresh install where no database exists yet.
  if [ ! -f "$DB_FILE" ]; then
    return
  fi
  local backup_path="${BACKUP_DIR}/db-pre-migration-$(date -u +%Y%m%dT%H%M%SZ).sqlite3"
  # This function's stdout is captured via $(...) by the caller, so the log
  # line goes to stderr -- otherwise it would end up concatenated into
  # backup_path along with the real value.
  log "Backing up ${DB_FILE} -> ${backup_path} before migrating..." >&2
  sqlite3 "$DB_FILE" ".backup '${backup_path}'"
  prune_backups
  echo "$backup_path"
}

# --- subcommands ---------------------------------------------------------------
cmd_install() {
  require_root
  ensure_user
  ensure_dirs

  if [ ! -f "$REPO_URL_FILE" ]; then
    local repo_url
    repo_url="$(resolve_repo_url_for_install)"
    log "Using repo URL: ${repo_url}"
    printf '%s\n' "$repo_url" > "$REPO_URL_FILE"
    chown "$APP_USER":"$APP_USER" "$REPO_URL_FILE"
    chmod 0644 "$REPO_URL_FILE"
  else
    warn "Repo URL already recorded at ${REPO_URL_FILE}, reusing it."
  fi

  ensure_system_packages
  ensure_node
  write_env_template
  write_unit
  self_install
  cmd_update
  systemctl enable --now "${APP_NAME}.service"
  systemctl enable --now "${APP_NAME}-purge.timer"
  log "Installed and started ${APP_NAME}.service and ${APP_NAME}-purge.timer."
  log "Edit ${ENV_FILE} then 'systemctl restart ${APP_NAME}' if you need to change config."
  log "Put Caddy (or nginx) in front using backend/deploy/Caddyfile.example -- it is not managed by this script."
}

cmd_update() {
  require_root
  ensure_system_packages
  ensure_node

  local repo_url
  repo_url="$(load_repo_url)"

  local tmp_clone
  tmp_clone="$(mktemp -d)"
  trap 'rm -rf "$tmp_clone"' RETURN

  log "Cloning ${repo_url} (${GIT_BRANCH})..."
  git clone --depth 1 --branch "$GIT_BRANCH" "$repo_url" "$tmp_clone"

  local hash release_name release_dir
  hash="$(git -C "$tmp_clone" rev-parse --short HEAD)"
  release_name="release_$(date +%Y%m%d_%H%M%S)_${hash}"
  release_dir="${RELEASES_DIR}/${release_name}"

  log "Staging release ${release_name}..."
  rsync -a --exclude .git "$tmp_clone/" "$release_dir/"
  chown -R "$APP_USER":"$APP_USER" "$release_dir"

  log "Building backend venv..."
  su -s /bin/bash "$APP_USER" -c "
    set -euo pipefail
    export HOME='${SHARED_DIR}'
    cd '${release_dir}/backend'
    python3 -m venv .venv
    .venv/bin/pip install --quiet --upgrade pip
    .venv/bin/pip install --quiet -r requirements.txt
  "

  log "Building frontend..."
  su -s /bin/bash "$APP_USER" -c "
    set -euo pipefail
    export HOME='${SHARED_DIR}'
    cd '${release_dir}/frontend'
    npm ci --silent
    npm run build --silent
  "

  if [ ! -x "${release_dir}/backend/.venv/bin/python" ]; then
    err "Backend build did not produce ${release_dir}/backend/.venv/bin/python -- aborting, nothing swapped."
    rm -rf "$release_dir"
    exit 1
  fi
  if [ ! -f "${release_dir}/frontend/dist/index.html" ]; then
    err "Frontend build did not produce ${release_dir}/frontend/dist/index.html -- aborting, nothing swapped."
    rm -rf "$release_dir"
    exit 1
  fi

  local backup_path
  backup_path="$(backup_db_if_present)"

  log "Running database migrations..."
  su -s /bin/bash "$APP_USER" -c "
    set -euo pipefail
    set -a; source '${ENV_FILE}'; set +a
    cd '${release_dir}/backend'
    .venv/bin/alembic upgrade head
  "

  local old_current=""
  if [ -L "$CURRENT_LINK" ]; then
    old_current="$(readlink -f "$CURRENT_LINK")"
  fi

  log "Swapping current -> ${release_name}..."
  atomic_symlink "$release_dir" "$CURRENT_LINK"

  log "Restarting ${APP_NAME}.service..."
  systemctl restart "${APP_NAME}.service"

  log "Health-checking http://127.0.0.1:${TARGET_PORT}${HEALTH_PATH} ..."
  if health_check; then
    log "Health check passed."
    if [ -n "$old_current" ] && [ "$old_current" != "$release_dir" ]; then
      atomic_symlink "$old_current" "$PREVIOUS_LINK"
    fi
    prune_releases
    log "Deploy complete: ${release_name}"
  else
    err "Health check FAILED. Rolling back code..."
    if [ -n "$old_current" ]; then
      atomic_symlink "$old_current" "$CURRENT_LINK"
      systemctl restart "${APP_NAME}.service"
      err "Rolled back to previous release ($(basename "$old_current"))."
    else
      err "No previous release to roll back to (this was the first deploy)."
    fi
    if [ -n "$backup_path" ]; then
      err "This does NOT undo a migration that already ran against ${DB_FILE}."
      err "If the migration itself is the problem, restore it: sqlite3 ${DB_FILE} \".restore '${backup_path}'\""
    fi
    rm -rf "$release_dir"
    exit 1
  fi
}

cmd_remove() {
  require_root
  warn "This will stop ${APP_NAME}, delete its systemd units, remove the"
  warn "'${APP_USER}' system user, and wipe ${BASE_DIR} (all releases + data + backups)."
  read -r -p "Type 'yes' to confirm: " confirm
  if [ "$confirm" != "yes" ]; then
    err "Aborted."
    exit 1
  fi

  systemctl stop "${APP_NAME}.service" "${APP_NAME}-purge.timer" 2>/dev/null || true
  systemctl disable "${APP_NAME}.service" "${APP_NAME}-purge.timer" 2>/dev/null || true
  rm -f "$UNIT_FILE" "$PURGE_SERVICE_FILE" "$PURGE_TIMER_FILE"
  systemctl daemon-reload

  if id -u "$APP_USER" >/dev/null 2>&1; then
    userdel "$APP_USER" 2>/dev/null || true
  fi

  rm -rf "$BASE_DIR"
  log "Removed ${APP_NAME}. ${INSTALLED_CTL} was left in place -- 'rm ${INSTALLED_CTL}' if you want it gone too."
}

# --- dispatch -------------------------------------------------------------------
case "${1:-}" in
  install) cmd_install ;;
  update)  cmd_update ;;
  remove)  cmd_remove ;;
  *)
    echo "Usage: artboard-ctl {install|update|remove}" >&2
    exit 2
    ;;
esac
