# Reverse proxy: forwards everything to artboard-frontend.service (vite
# preview, 127.0.0.1:4173), which already proxies /api to the backend on
# 127.0.0.1:8000 itself (frontend/vite.config.ts's `preview.proxy`). Caddy
# does not need its own /api rule or a `root`/`file_server` block here --
# there is exactly one upstream to reach, the same one a Cloudflare Tunnel
# would point at (see ../../deploy/cloudflared/config.yml.template).
#
# This file is *not* managed by artboard-ctl -- install Caddy yourself if
# you want this path instead of the tunnel, and point it at 4173 like this.

artboard.example.com {
	encode zstd gzip

	reverse_proxy 127.0.0.1:4173

	# Uploads are capped in the app too (ARTBOARD_MAX_UPLOAD_BYTES); this stops a
	# oversized body before it reaches Python at all.
	request_body {
		max_size 32MB
	}
}
