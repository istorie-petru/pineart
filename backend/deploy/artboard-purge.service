[Unit]
Description=Art Board trash purge
After=network.target

[Service]
Type=oneshot
User=artboard
Group=artboard
WorkingDirectory=/opt/artboard/backend
ExecStart=/opt/artboard/backend/.venv/bin/python -m app.cli purge
EnvironmentFile=/opt/artboard/.env
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/artboard/data
