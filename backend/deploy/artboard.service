[Unit]
Description=Art Board App
After=network.target

[Service]
User=artboard
Group=artboard
WorkingDirectory=/opt/artboard/backend
ExecStart=/opt/artboard/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
EnvironmentFile=/opt/artboard/.env
Restart=on-failure
RestartSec=3

# Bound to 127.0.0.1 above: the reverse proxy is the only thing that should be
# able to reach the app directly. The hardening below is not decoration — the
# app writes user-supplied files to disk, so limiting what the process can touch
# is the difference between a bad upload being a bad upload and it being a
# foothold.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/artboard/data
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=false

[Install]
WantedBy=multi-user.target
