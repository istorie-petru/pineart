# Art Board backend configuration.
# Copy to .env and adjust. All values have working defaults for local development.

# Absolute or relative path to the data directory (db + images live here).
# Left unset, this defaults to the platform's normal per-user data location
# instead of a folder inside the app checkout — ~/.local/share/pineart (or
# $XDG_DATA_HOME/pineart if set) on Linux/macOS, /var/lib/pineart when run as
# root, %APPDATA%\Pineart on Windows. Uncomment to pin it somewhere specific.
# ARTBOARD_DATA_DIR=./data

# SQLAlchemy URL. Leave unset to use <data_dir>/db.sqlite3.
# ARTBOARD_DATABASE_URL=sqlite:///./data/db.sqlite3

# Internal SearXNG base URL. Bind SearXNG to 127.0.0.1 only; it is reachable
# exclusively through this backend's /api/discover proxy.
# The value stored in Settings -> Discovery takes precedence over this one.
ARTBOARD_SEARXNG_URL=

# CORS origins for the Vite dev server (comma-separated). Empty in production,
# where the reverse proxy serves the frontend from the same origin.
ARTBOARD_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Max accepted upload size per file, in bytes (default 32 MiB).
ARTBOARD_MAX_UPLOAD_BYTES=33554432

# Mark the session cookie Secure. Leave false for plain-HTTP local development —
# a Secure cookie is silently dropped over http, which looks like a broken login
# rather than a setting. Set to true in production, where TLS is terminated by
# the reverse proxy.
ARTBOARD_SECURE_COOKIES=false
